{
  "name": "patchworkfs",
  "displayName": "patchworkfs",
  "description": "Edit automerge patchwork-filesystem folders in VS Code",
  "version": "0.2.1",
  "license": "AGPL-3.0-or-later",
  "publisher": "chee",
  "repository": {
    "type": "git",
    "url": "https://github.com/chee/patchwork-lsp"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "automerge.openFolder",
        "title": "PatchworkFS: Open Folder"
      },
      {
        "command": "automerge.restart",
        "title": "PatchworkFS: Restart"
      },
      {
        "command": "automerge.showStatus",
        "title": "PatchworkFS: Show Status"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "package": "node build.mjs && vsce package --no-dependencies",
    "publish": "node build.mjs && vsce publish --no-dependencies",
    "login": "vsce login"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.91.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2",
    "vscode-languageclient": "^10.1.0"
  }
}
